name = "smart-care-sync-api"
main = "worker.js"
compatibility_date = "2024-09-23"

[observability]
enabled = false

[[d1_databases]]
binding = "DB"
database_name = "smart-care-sync"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[[kv_namespaces]]
binding = "SMART_CARE_STATE"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
